# PostgreSQL bağlantı sətri
DATABASE_URL=postgresql://user:password@localhost:5432/qarabag_tour

# Server
CLIENT_URL=http://localhost:3000

# JWT
JWT_SECRET=cox-guclu-ve-gizli-bir-acar-buraya-yazin
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Session (OAuth axını üçün lazımdır)
SESSION_SECRET=basqa-bir-guclu-gizli-acar

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Facebook OAuth (https://developers.facebook.com/apps)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback

# Email göndərmə (təsdiqləmə kodu üçün) — Gmail nümunəsi
# Gmail-də 2FA açıq olmalıdır, sonra "App Password" yaradıb SMTP_PASSWORD-ə yazın
# (adi Gmail şifrəniz İŞLƏMƏYƏCƏK — mütləq App Password olmalıdır)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sizin-email@gmail.com
SMTP_PASSWORD=16-heneli-app-password
SMTP_FROM_EMAIL=sizin-email@gmail.com
